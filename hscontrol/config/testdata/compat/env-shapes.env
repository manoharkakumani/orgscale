ORGSCALE_SERVER_URL=https://hs.example.com
ORGSCALE_NOISE_PRIVATE_KEY_PATH=/var/lib/orgscale/noise.key
ORGSCALE_PREFIXES_V4=100.64.0.0/10
ORGSCALE_DATABASE_TYPE=sqlite
ORGSCALE_DATABASE_SQLITE_PATH=/var/lib/orgscale/db.sqlite
ORGSCALE_DNS_MAGIC_DNS=false
ORGSCALE_DNS_OVERRIDE_LOCAL_DNS=false
# Lists: JSON arrays, commas and padding are not parsed.
ORGSCALE_DNS_SEARCH_DOMAINS=["a.example.com","b.example.com"]
ORGSCALE_DNS_NAMESERVERS_GLOBAL=1.1.1.1,8.8.8.8
ORGSCALE_OIDC_ALLOWED_DOMAINS=["example.com"]
ORGSCALE_OIDC_ALLOWED_GROUPS=  a  b
ORGSCALE_DERP_URLS=https://a.example.com/derp.json https://b.example.com/derp.json
ORGSCALE_TRUSTED_PROXIES=10.0.0.0/8 192.168.0.0/16
# Maps: non-JSON value, non-string value, key case.
ORGSCALE_DNS_NAMESERVERS_SPLIT=corp.example.com=10.0.0.1
ORGSCALE_OIDC_EXTRA_PARAMS={"Domain_Hint":"env","n":1}
# Scalars: durations without unit, octal mode, numeric bool.
ORGSCALE_TUNING_BATCH_CHANGE_DELAY=800
ORGSCALE_DERP_UPDATE_FREQUENCY=30
ORGSCALE_NODE_EXPIRY=90
ORGSCALE_UNIX_SOCKET_PERMISSION=0700
ORGSCALE_TAILDROP_ENABLED=0
