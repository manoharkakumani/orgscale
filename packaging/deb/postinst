#!/bin/sh
# postinst script for orgscale.

set -e

# Summary of how this script can be called:
#        * <postinst> 'configure' <most-recently-configured-version>
#        * <old-postinst> 'abort-upgrade' <new version>
#        * <conflictor's-postinst> 'abort-remove' 'in-favour' <package>
#          <new-version>
#        * <postinst> 'abort-remove'
#        * <deconfigured's-postinst> 'abort-deconfigure' 'in-favour'
#          <failed-install-package> <version> 'removing'
#          <conflicting-package> <version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package.

ORGSCALE_USER="orgscale"
ORGSCALE_GROUP="orgscale"
ORGSCALE_HOME_DIR="/var/lib/orgscale"
ORGSCALE_SHELL="/usr/sbin/nologin"
ORGSCALE_SERVICE="orgscale.service"

case "$1" in
    configure)
      groupadd --force --system "$ORGSCALE_GROUP"
      if ! id -u "$ORGSCALE_USER" >/dev/null 2>&1; then
        useradd --system --shell "$ORGSCALE_SHELL" \
          --gid "$ORGSCALE_GROUP" --home-dir "$ORGSCALE_HOME_DIR" \
          --comment "orgscale default user" "$ORGSCALE_USER"
      fi

      # Enable service and keep track of its state
      if deb-systemd-helper --quiet was-enabled "$ORGSCALE_SERVICE"; then
        deb-systemd-helper enable "$ORGSCALE_SERVICE" >/dev/null || true
      else
        deb-systemd-helper update-state "$ORGSCALE_SERVICE" >/dev/null || true
      fi

      # Bounce service
      if [ -d /run/systemd/system ]; then
        systemctl --system daemon-reload >/dev/null || true
        # Check what the unit would load: its user, working directory and
        # HOME, and no ORGSCALE_* variables from this shell. A rejected
        # configuration is not restarted, so an upgraded orgscale keeps the
        # previous version until something else restarts it.
        if (cd "$ORGSCALE_HOME_DIR" && setpriv --reuid="$ORGSCALE_USER" --regid="$ORGSCALE_GROUP" --init-groups env -i HOME="$ORGSCALE_HOME_DIR" /usr/bin/orgscale check config) >/dev/null; then
          if [ -n "$2" ]; then
            deb-systemd-invoke restart "$ORGSCALE_SERVICE" >/dev/null || true
          else
            deb-systemd-invoke start "$ORGSCALE_SERVICE" >/dev/null || true
          fi
        else
          if [ -n "$2" ]; then
            echo 'orgscale was not restarted after the upgrade: its configuration does not pass "orgscale check config" (errors above).' >&2
            echo 'A running orgscale keeps the previous version only until it restarts: needrestart after apt, a reboot or a crash starts this version, which refuses the configuration and stays stopped until it is fixed.' >&2
          else
            echo 'orgscale was not started: its configuration does not pass "orgscale check config" (errors above).' >&2
          fi
          echo 'Fix what it names in /etc/orgscale/config.yaml; a new install needs server_url.' >&2
          echo '"orgscale generate config --minimal" prints the keys every server must set.' >&2
          echo 'Then run: sudo systemctl restart orgscale' >&2
          echo 'The check does not see "systemctl edit" drop-ins (variables, an EnvironmentFile, or an ExecStart that points at another config);' >&2
          echo "if orgscale's configuration is set there, start it yourself." >&2
        fi
      fi
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
    ;;
esac
